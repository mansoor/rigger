# ── Rigger UI ───────────────────────────────────────────────────────────────────

# Port to expose the UI on the host (direct access, e.g. http://server:8080)
RIGGER_PORT=8080

# Must be a long random string — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── Traefik / SSL ─────────────────────────────────────────────────────────────

# Email address for Let's Encrypt certificate notifications and recovery.
# Required for SSL certificate issuance on any workspace domain.
ACME_EMAIL=your@email.com

# Optional: domain to expose the Rigger UI itself via Traefik + SSL.
# Uncomment the labels block in docker-compose.yml and set this value.
# RIGGER_DOMAIN=rigger.example.com
