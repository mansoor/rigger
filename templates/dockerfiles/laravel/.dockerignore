# =============================================================================
# .dockerignore — Laravel  (prod / stage)
# Goal: smallest possible build context; no secrets, dev tools, or test debris.
# =============================================================================

# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Dependency directories ────────────────────────────────────────────────────
# vendor/ is intentionally NOT ignored: a CodeCanyon / marketplace app ships a
# complete vendor/, and baking it lets the build skip composer (see Dockerfile),
# so it needs no network (avoids the api.github.com timeout on `composer update`).
# A git-source app that ships no vendor/ has nothing to copy, so composer still
# resolves it. node_modules stays ignored (huge; apps ship built assets, not it).
node_modules

# ── Laravel runtime cache (generated at startup) ──────────────────────────────
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# ── Frontend dev-server marker (never bake into an image) ────────────────────
# `public/hot` is Vite's HMR marker; if baked, the app tries to load assets from a
# dev server that isn't running. NOTE: pre-built assets (public/build,
# public/mix-manifest.json) are intentionally KEPT — CodeCanyon apps ship them and
# may not rebuild (their installer often uses Laravel Mix via mix()); an in-container
# `npm run build` overwrites them, so keeping them is safe either way.
public/hot

# ── Test suite ────────────────────────────────────────────────────────────────
tests
coverage
.phpunit*
phpunit.xml
phpunit.xml.dist

# ── Development & CI config ───────────────────────────────────────────────────
.editorconfig
.styleci.yml
.php-cs-fixer*
Makefile
Dockerfile*
docker-compose*.yml
docker
.travis.yml
.circleci
.github/workflows

# ── Docs & changelogs ─────────────────────────────────────────────────────────
docs
*.md
CHANGELOG*
UPGRADE*
CONTRIBUTING*

# ── Tooling ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.swp
*.swo
