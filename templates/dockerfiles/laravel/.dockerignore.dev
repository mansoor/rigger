# =============================================================================
# .dockerignore.dev — Laravel (dev environment)
# The dev image is now SELF-CONTAINED (Dockerfile.dev does `COPY . .` and serves
# via `php artisan serve` — no runtime bind mount), so the application source
# MUST be baked into the build context. This file therefore only excludes what's
# reinstalled or regenerated inside the container — NOT app code. It keeps tests
# and dev config (this is a dev image with Xdebug), which the prod variant strips.
# =============================================================================

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Reinstalled in container ──────────────────────────────────────────────────
# NOTE: vendor/ is intentionally NOT ignored. CodeCanyon / marketplace apps ship a
# complete vendor/ (and a matching composer.lock); baking it lets the build skip
# composer entirely (see Dockerfile.dev), so it never needs network — which is what
# made `composer update` time out on api.github.com. A git-source app that ships no
# vendor/ has nothing to copy, so composer still resolves it normally.
node_modules

# ── Laravel runtime cache (recreated at build/startup) ────────────────────────
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# ── Version control & CI ──────────────────────────────────────────────────────
.git
.gitignore
.github

# ── Frontend dev-server marker (never bake into an image) ────────────────────
# `public/hot` is Vite's HMR marker; if baked, the app tries to load assets from a
# dev server that isn't running. NOTE: pre-built assets (public/build,
# public/mix-manifest.json) are intentionally KEPT — CodeCanyon apps ship them and
# may not rebuild (their installer often uses Laravel Mix via mix()); an in-container
# `npm run build` overwrites them, so keeping them is safe either way.
public/hot

# ── Docker / compose scaffolding (not needed inside the image) ───────────────
docker-compose*.yml

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.swp
*.swo
