{
  "name": "homepage",
  "label": "Homepage",
  "description": "A modern, fully static, fast application dashboard with service/bookmark widgets. Configure via YAML files in the mounted config volume. NOTE: set HOMEPAGE_ALLOWED_HOSTS to your domain (or * to allow all) or the UI returns a host-validation error.",
  "tags": [
    "dashboard",
    "homelab",
    "productivity"
  ],
  "images": [
    {
      "name": "app",
      "image": "ghcr.io/gethomepage/homepage",
      "tag": "latest",
      "port": 3000,
      "web_routed": true,
      "host_port": "${HOMEPAGE_PORT}",
      "command": "",
      "healthcheck": "",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "20s"
      },
      "volumes": [
        "./volumes/homepage_config:/app/config"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {
        "HOMEPAGE_ALLOWED_HOSTS": "${HOMEPAGE_ALLOWED_HOSTS}"
      }
    }
  ],
  "default_env_vars": {
    "HOMEPAGE_PORT": "3000",
    "HOMEPAGE_ALLOWED_HOSTS": "*"
  }
}
