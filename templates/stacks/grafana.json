{
  "name": "grafana",
  "label": "Grafana + Prometheus",
  "description": "Grafana dashboards with Prometheus metrics collection",
  "tags": [
    "monitoring",
    "metrics",
    "dashboards"
  ],
  "images": [
    {
      "name": "prometheus",
      "image": "prom/prometheus",
      "tag": "v2.48.0",
      "port": 9090,
      "host_port": "${PROMETHEUS_PORT}",
      "command": "",
      "healthcheck": "wget -qO- http://localhost:9090/-/healthy -o /dev/null 2>&1 || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "30s"
      },
      "volumes": [
        "./volumes/prometheus_data:/prometheus",
        "./prometheus.yml:/etc/prometheus/prometheus.yml:ro"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {}
    },
    {
      "name": "grafana",
      "image": "grafana/grafana",
      "tag": "10.2.0",
      "port": 3000,
      "host_port": "${GRAFANA_PORT}",
      "command": "",
      "healthcheck": "curl -sf http://localhost:3000/api/health -o /dev/null || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "30s"
      },
      "volumes": [
        "./volumes/grafana_data:/var/lib/grafana"
      ],
      "depends_on": [
        "prometheus"
      ],
      "extra_ports": [],
      "env_vars": {
        "GF_SECURITY_ADMIN_PASSWORD": "${GF_SECURITY_ADMIN_PASSWORD}",
        "GF_SECURITY_ADMIN_USER": "${GF_SECURITY_ADMIN_USER}",
        "GF_SERVER_HTTP_PORT": "3000"
      }
    }
  ],
  "default_env_vars": {
    "PROMETHEUS_PORT": "9090",
    "GRAFANA_PORT": "3000",
    "GF_SECURITY_ADMIN_USER": "admin",
    "GF_SECURITY_ADMIN_PASSWORD": "CHANGE_ME"
  }
}