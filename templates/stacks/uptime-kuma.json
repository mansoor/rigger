{
  "name": "uptime-kuma",
  "label": "Uptime Kuma",
  "description": "Self-hosted uptime monitoring with a beautiful status page",
  "tags": [
    "monitoring",
    "uptime",
    "status"
  ],
  "images": [
    {
      "name": "app",
      "image": "louislam/uptime-kuma",
      "tag": "1",
      "port": 3001,
      "host_port": "${KUMA_PORT}",
      "command": "",
      "healthcheck": "curl -sf http://localhost:3001/ -o /dev/null || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "30s"
      },
      "volumes": [
        "./volumes/kuma_data:/app/data"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {}
    }
  ],
  "default_env_vars": {
    "KUMA_PORT": "3001"
  }
}