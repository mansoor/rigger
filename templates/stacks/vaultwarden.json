{
  "name": "vaultwarden",
  "label": "Vaultwarden (Bitwarden)",
  "description": "Unofficial Bitwarden-compatible server \u2014 self-hosted password manager",
  "tags": [
    "security",
    "passwords",
    "bitwarden"
  ],
  "images": [
    {
      "name": "app",
      "image": "vaultwarden/server",
      "tag": "latest",
      "port": 80,
      "host_port": "${VW_PORT}",
      "command": "",
      "healthcheck": "curl -sf http://localhost/alive -o /dev/null || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "30s"
      },
      "volumes": [
        "./volumes/vw_data:/data"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {
        "ADMIN_TOKEN": "${ADMIN_TOKEN}",
        "DOMAIN": "${VW_DOMAIN}",
        "SIGNUPS_ALLOWED": "false",
        "WEBSOCKET_ENABLED": "true"
      }
    }
  ],
  "default_env_vars": {
    "VW_PORT": "8080",
    "ADMIN_TOKEN": "CHANGE_ME_STRONG_RANDOM_TOKEN",
    "VW_DOMAIN": "https://vaultwarden.example.com"
  }
}