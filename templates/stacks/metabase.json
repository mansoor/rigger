{
  "name": "metabase",
  "label": "Metabase",
  "description": "Open-source business-intelligence and dashboarding tool. Uses a PostgreSQL application database; connect your own data sources after setup.",
  "tags": [
    "analytics",
    "bi",
    "dashboards"
  ],
  "images": [
    {
      "name": "db",
      "image": "postgres",
      "tag": "15-alpine",
      "port": 5432,
      "host_port": "",
      "command": "",
      "healthcheck": "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}",
      "healthcheck_config": {
        "interval": "10s",
        "timeout": "5s",
        "retries": "5",
        "start_period": "30s"
      },
      "volumes": [
        "./volumes/db_data:/var/lib/postgresql/data"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {
        "POSTGRES_DB": "${POSTGRES_DB}",
        "POSTGRES_USER": "${POSTGRES_USER}",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      }
    },
    {
      "name": "app",
      "image": "metabase/metabase",
      "tag": "latest",
      "port": 3000,
      "web_routed": true,
      "host_port": "${METABASE_PORT}",
      "command": "",
      "healthcheck": "curl -sf http://localhost:3000/api/health -o /dev/null || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "5",
        "start_period": "120s"
      },
      "volumes": [],
      "depends_on": [
        "db"
      ],
      "extra_ports": [],
      "env_vars": {
        "MB_DB_TYPE": "postgres",
        "MB_DB_HOST": "db",
        "MB_DB_PORT": "5432",
        "MB_DB_DBNAME": "${POSTGRES_DB}",
        "MB_DB_USER": "${POSTGRES_USER}",
        "MB_DB_PASS": "${POSTGRES_PASSWORD}"
      }
    }
  ],
  "default_env_vars": {
    "POSTGRES_DB": "metabase",
    "POSTGRES_USER": "metabase_user",
    "POSTGRES_PASSWORD": "CHANGE_ME",
    "METABASE_PORT": "3000"
  }
}
