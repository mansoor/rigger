{
  "name": "immich",
  "label": "Immich Photo Management",
  "description": "Self-hosted photo and video backup with PostgreSQL and Redis",
  "tags": [
    "photos",
    "media",
    "backup"
  ],
  "images": [
    {
      "name": "db",
      "image": "tensorchord/pgvecto-rs",
      "tag": "pg15-v0.2.0",
      "port": 5432,
      "host_port": "",
      "command": "postgres -c shared_preload_libraries=vectors.so -c search_path=\"$$user\", public, vectors -c logging_collector=on -c max_wal_size=2GB -c shared_buffers=512MB -c wal_compression=lz4",
      "healthcheck": "pg_isready -U ${DB_USERNAME} -d ${DB_DATABASE_NAME}",
      "healthcheck_config": {
        "interval": "10s",
        "timeout": "5s",
        "retries": "5",
        "start_period": "30s"
      },
      "volumes": [
        "./volumes/db_data:/var/lib/postgresql/data"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {
        "POSTGRES_PASSWORD": "${DB_PASSWORD}",
        "POSTGRES_USER": "${DB_USERNAME}",
        "POSTGRES_DB": "${DB_DATABASE_NAME}"
      }
    },
    {
      "name": "redis",
      "image": "redis",
      "tag": "7-alpine",
      "port": 6379,
      "host_port": "",
      "command": "redis-server --appendonly yes",
      "healthcheck": "redis-cli ping | grep -q PONG || exit 1",
      "healthcheck_config": {
        "interval": "10s",
        "timeout": "3s",
        "retries": "3",
        "start_period": "10s"
      },
      "volumes": [
        "./volumes/redis_data:/data"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {}
    },
    {
      "name": "app",
      "image": "ghcr.io/immich-app/immich-server",
      "tag": "release",
      "port": 2283,
      "host_port": "${IMMICH_PORT}",
      "command": "",
      "healthcheck": "curl -sf http://localhost:2283/api/server-info/ping -o /dev/null || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "60s"
      },
      "volumes": [
        "./volumes/immich_uploads:${UPLOAD_LOCATION}",
        "./hwaccel.transcoding.yml:/usr/src/app/hwaccel.transcoding.yml:ro"
      ],
      "depends_on": [
        "db",
        "redis"
      ],
      "extra_ports": [],
      "env_vars": {
        "DB_HOSTNAME": "db",
        "DB_PORT": "5432",
        "DB_DATABASE_NAME": "${DB_DATABASE_NAME}",
        "DB_USERNAME": "${DB_USERNAME}",
        "DB_PASSWORD": "${DB_PASSWORD}",
        "REDIS_HOSTNAME": "redis"
      }
    },
    {
      "name": "ml",
      "image": "ghcr.io/immich-app/immich-machine-learning",
      "tag": "release",
      "port": 3003,
      "host_port": "",
      "command": "",
      "healthcheck": "curl -sf http://localhost:3003/ping -o /dev/null || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "90s"
      },
      "volumes": [
        "./volumes/ml_cache:/cache"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {}
    }
  ],
  "default_env_vars": {
    "DB_DATABASE_NAME": "immich",
    "DB_USERNAME": "immich_user",
    "DB_PASSWORD": "CHANGE_ME",
    "IMMICH_PORT": "2283",
    "UPLOAD_LOCATION": "/usr/src/app/upload"
  }
}