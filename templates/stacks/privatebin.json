{
  "name": "privatebin",
  "label": "PrivateBin",
  "description": "Minimalist, open-source, end-to-end encrypted pastebin where the server has zero knowledge of pasted data. All-in-one nginx + php-fpm image; stores pastes on a data volume.",
  "tags": [
    "pastebin",
    "privacy",
    "sharing"
  ],
  "images": [
    {
      "name": "app",
      "image": "privatebin/nginx-fpm-alpine",
      "tag": "latest",
      "port": 8080,
      "web_routed": true,
      "host_port": "8080",
      "command": "",
      "healthcheck": "wget -q --spider http://127.0.0.1:8080/ || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "15s"
      },
      "volumes": [
        "./volumes/privatebin_data:/srv/data"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {}
    }
  ],
  "default_env_vars": {}
}
