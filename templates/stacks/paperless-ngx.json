{
  "name": "paperless-ngx",
  "label": "Paperless-ngx",
  "description": "Scan, index and archive documents with OCR and full-text search. Backed by PostgreSQL + Redis. A first admin is created from PAPERLESS_ADMIN_USER/PASSWORD (reveal the generated password in Env Vars). Add Gotenberg/Tika services later for Office/email conversion.",
  "tags": [
    "documents",
    "productivity",
    "ocr",
    "archive"
  ],
  "images": [
    {
      "name": "db",
      "image": "postgres",
      "tag": "16-alpine",
      "port": 5432,
      "host_port": "",
      "command": "",
      "healthcheck": "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}",
      "healthcheck_config": {
        "interval": "10s",
        "timeout": "5s",
        "retries": "5",
        "start_period": "30s"
      },
      "volumes": [
        "./volumes/db_data:/var/lib/postgresql/data"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {
        "POSTGRES_DB": "${POSTGRES_DB}",
        "POSTGRES_USER": "${POSTGRES_USER}",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      }
    },
    {
      "name": "broker",
      "image": "redis",
      "tag": "7-alpine",
      "port": 6379,
      "host_port": "",
      "command": "",
      "healthcheck": "redis-cli ping || exit 1",
      "healthcheck_config": {
        "interval": "10s",
        "timeout": "5s",
        "retries": "5",
        "start_period": "10s"
      },
      "volumes": [
        "./volumes/redis_data:/data"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {}
    },
    {
      "name": "app",
      "image": "ghcr.io/paperless-ngx/paperless-ngx",
      "tag": "latest",
      "port": 8000,
      "web_routed": true,
      "host_port": "${PAPERLESS_PORT}",
      "command": "",
      "healthcheck": "curl -fs http://localhost:8000/ -o /dev/null || exit 1",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "5",
        "start_period": "120s"
      },
      "volumes": [
        "./volumes/paperless_data:/usr/src/paperless/data",
        "./volumes/paperless_media:/usr/src/paperless/media",
        "./volumes/paperless_export:/usr/src/paperless/export",
        "./volumes/paperless_consume:/usr/src/paperless/consume"
      ],
      "depends_on": [
        "db",
        "broker"
      ],
      "extra_ports": [],
      "env_vars": {
        "PAPERLESS_REDIS": "redis://broker:6379",
        "PAPERLESS_DBHOST": "db",
        "PAPERLESS_DBNAME": "${POSTGRES_DB}",
        "PAPERLESS_DBUSER": "${POSTGRES_USER}",
        "PAPERLESS_DBPASS": "${POSTGRES_PASSWORD}",
        "PAPERLESS_SECRET_KEY": "${PAPERLESS_SECRET_KEY}",
        "PAPERLESS_URL": "${PAPERLESS_URL}",
        "PAPERLESS_ADMIN_USER": "${PAPERLESS_ADMIN_USER}",
        "PAPERLESS_ADMIN_PASSWORD": "${PAPERLESS_ADMIN_PASSWORD}"
      }
    }
  ],
  "default_env_vars": {
    "POSTGRES_DB": "paperless",
    "POSTGRES_USER": "paperless",
    "POSTGRES_PASSWORD": "CHANGE_ME",
    "PAPERLESS_SECRET_KEY": "CHANGE_ME",
    "PAPERLESS_ADMIN_USER": "admin",
    "PAPERLESS_ADMIN_PASSWORD": "CHANGE_ME",
    "PAPERLESS_URL": "http://localhost:8000",
    "PAPERLESS_PORT": "8000"
  }
}
