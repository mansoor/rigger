{
  "name": "pairdrop",
  "label": "PairDrop",
  "description": "Local file sharing in the browser — an open-source, self-hosted AirDrop-style drop between devices on the same network (LinuxServer image). Works best served over HTTPS.",
  "tags": [
    "files",
    "sharing",
    "productivity"
  ],
  "images": [
    {
      "name": "app",
      "image": "lscr.io/linuxserver/pairdrop",
      "tag": "latest",
      "port": 3000,
      "web_routed": true,
      "host_port": "3000",
      "command": "",
      "healthcheck": "",
      "healthcheck_config": {
        "interval": "30s",
        "timeout": "10s",
        "retries": "3",
        "start_period": "15s"
      },
      "volumes": [
        "./volumes/pairdrop_config:/config"
      ],
      "depends_on": [],
      "extra_ports": [],
      "env_vars": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "Etc/UTC"
      }
    }
  ],
  "default_env_vars": {}
}
